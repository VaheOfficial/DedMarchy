# Maintainer: DedSec (VaheOfficial/DedMarchy)
# Upstream recipe: Arch Linux extra/open-vm-tools (Sergej Pupykin et al.)
#
# Arch's open-vm-tools plus clipway, a Wayland backend for the dndcp
# copy/paste plugin: stock open-vm-tools only speaks X11 for the clipboard,
# so host<->guest copy and paste is dead in a Hyprland session. The backend
# drives the clipboard through wl-copy/wl-paste (data-control protocol) and
# is chosen at runtime whenever WAYLAND_DISPLAY is set. Plain text only.
# https://github.com/krisztianfekete/clipway (patch verified on 13.0.5 and
# 13.1.0 upstream; needs a rebase when Arch moves to another release).

pkgname=open-vm-tools
epoch=6
pkgver=13.1.0
pkgrel=3.2
pkgdesc='The Open Virtual Machine Tools (open-vm-tools) with the clipway Wayland clipboard backend'
arch=('x86_64')
url='https://github.com/vmware/open-vm-tools'
license=('LGPL-2.1-only')
# gtkmm-4.0 is a hard dependency here: 13.1.0's configure wants it, and the
# dndcp plugin that carries the clipway clipboard backend links against it.
depends=('fuse3' 'icu' 'iproute2' 'libdnet' 'libmspack' 'libsigc++'
         'libxss' 'lsb-release' 'procps-ng'
         'uriparser' 'which' 'xmlsec' 'wl-clipboard' 'gtkmm-4.0' 'libxtst')
makedepends=('git' 'chrpath' 'doxygen' 'gtkmm3' 'python' 'rpcsvc-proto' 'glib2-devel')
optdepends=('gtkmm3: DnD/CP plugin'
            'libxtst: DnD/CP, resolution set plugins'
            'netctl: suspend-resume network state'
            'networkmanager: suspend-resume network state')
backup=('etc/pam.d/vmtoolsd'
        'etc/vmware-tools/vgauth.conf'
        'etc/xdg/autostart/vmware-user.desktop')
options=('docs')
source=("git+https://github.com/vmware/open-vm-tools#tag=stable-${pkgver}"
        'vmtoolsd.pam'
        'vmtoolsd.service'
        'vmware-vmblock-fuse.service'
        open-vm-tools-gcc16.patch
        0001-dndcp-wayland-clipboard-backend.patch)
sha256sums=('916a09225a22653ec5e56b1df5bbfacc7f69b2b9e8ac734052936bcb75cde49a'
            '9848f4b621bb1134e463fea099f03933cf3f48f1ac5e580228abef264d26137e'
            '0626cc86232f75a7286c24c52d6b44260bba55e2e96c17fa22ed36decb61a4d9'
            '99e3cc1da20a751049144cc02dec77174a55109b5b5960e1facd78709da7724f'
            '2c3b3fa378c86307223b9977c6b07ec1781d5b396c1526ee7fef73b7604a0c6d'
            'SKIP')

prepare() {
  cd "${srcdir}/${pkgname}/open-vm-tools/"
  # clipway's paths are relative to the open-vm-tools/ subdirectory, like Arch's patch
  patch -Np1 -i "${srcdir}/0001-dndcp-wayland-clipboard-backend.patch"
  patch -Np1 -i ../../open-vm-tools-gcc16.patch
  autoreconf -vi
}

build() {
  cd "${srcdir}/${pkgname}/open-vm-tools/"

  sh ./configure \
    --prefix=/usr \
    --sbindir=/usr/bin \
    --sysconfdir=/etc \
    --with-udev-rules-dir=/usr/lib/udev/rules.d \
    --without-kernel-modules
  make
}

package() {
  cd "${srcdir}/${pkgname}/open-vm-tools/"

  make install DESTDIR="${pkgdir}"
  chmod 7755 "${pkgdir}"/usr/bin/vmware-user-suid-wrapper

  # install vmware-xdg-detect-de
  install -D -m0755 scripts/common/vmware-xdg-detect-de "${pkgdir}"/usr/bin/vmware-xdg-detect-de

  # install pam configuration
  install -D -m0644 "${srcdir}"/vmtoolsd.pam "${pkgdir}"/etc/pam.d/vmtoolsd

  # install systemd files
  install -D -m0644 "${srcdir}"/vmtoolsd.service "${pkgdir}"/usr/lib/systemd/system/vmtoolsd.service
  install -D -m0644 "${srcdir}"/vmware-vmblock-fuse.service "${pkgdir}"/usr/lib/systemd/system/vmware-vmblock-fuse.service

  # the Wayland backend must be in the plugin, not just applied with fuzz
  # into a branch the build skips (clipway's own CI checks the same thing)
  if ! grep -q "wl-copy" "${pkgdir}"/usr/lib/open-vm-tools/plugins/vmusr/libdndcp.so; then
    echo "clipway backend missing from libdndcp.so" >&2
    return 1
  fi
}
