# DedSec Plymouth Theme Script
#
# Keeps the Omarchy boot flow (eased fake progress, drive decryption prompt,
# messages) and adds a DedSec console readout under the logo: boot lines are
# typed out character by character behind a scrambling cursor, finished lines
# dim to the log color, and a thin progress line tracks the boot.

Window.SetBackgroundTopColor(0.02, 0.04, 0.055);
Window.SetBackgroundBottomColor(0.02, 0.04, 0.055);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 60);
logo.sprite.SetOpacity(1);

logo.bottom = logo.sprite.GetY() + logo.image.GetHeight();

# Use these to adjust the progress timing
global.fake_progress_limit = 0.7;     # Target percentage for fake progress (0.0 to 1.0)
global.fake_progress_duration = 15.0; # Duration in seconds to reach limit

# Progress animation variables
global.animation_frame = 0;
global.fake_progress = 0.0;
global.real_progress = 0.0;
global.fake_progress_active = 0;
global.fake_progress_start_time = 0.0; # Track when fake progress started
global.password_shown = 0;             # Track if password dialog has been shown
global.max_progress = 0.0;             # Track the maximum progress reached to prevent backwards movement

#----------------------------------------- Console readout --------------------------------

# DedSec palette as 0-1 floats: neon green, dimmed log green, muted panel blue
global.green_r = 0.0;
global.green_g = 1.0;
global.green_b = 0.255;
global.dim_r = 0.42;
global.dim_g = 0.56;
global.dim_b = 0.52;
global.muted_r = 0.118;
global.muted_g = 0.188;
global.muted_b = 0.267;

global.line_count = 6;
global.boot_lines = [];
global.boot_lines[0] = "> INITIALIZING KERNEL";
global.boot_lines[1] = "> LOADING SYSTEM MODULES";
global.boot_lines[2] = "> MOUNTING FILESYSTEMS";
global.boot_lines[3] = "> NETWORK INTERFACE: STANDBY";
global.boot_lines[4] = "> SECURITY PROTOCOLS: ACTIVE";
global.boot_lines[5] = "> DEDSEC SYSTEM READY";

# Characters flashed in front of the cursor while a line is being decoded
global.glitch_chars = "#%&@/<>_-=+*$?";
global.glitch_count = 14;
global.cursor_char = "█";

global.line_height = 22;
global.type_frames = 2;   # frames per character (50 fps -> 25 chars/s)
global.blink_frames = 25; # frames per cursor toggle

# Left-align the block on the widest line so the readout reads like a log
global.block_width = 0;
for (i = 0; i < global.line_count; i++) {
  probe = Image.Text(global.boot_lines[i], global.green_r, global.green_g, global.green_b);
  if (probe.GetWidth() > global.block_width) {
    global.block_width = probe.GetWidth();
  }
}
global.block_x = Window.GetWidth() / 2 - global.block_width / 2;
global.block_y = logo.bottom + 44;

global.line_sprites = [];
for (i = 0; i < global.line_count; i++) {
  global.line_sprites[i] = Sprite();
  global.line_sprites[i].SetPosition(global.block_x, global.block_y + i * global.line_height, 10000);
  global.line_sprites[i].SetOpacity(0);
}

# Typewriter state
global.console_visible = 1;
global.lines_allowed = 1;  # how many lines the boot progress has unlocked
global.type_line = 0;      # line currently being typed
global.type_pos = 0;       # characters revealed on that line
global.type_tick = 0;
global.cursor_tick = 0;
global.cursor_on = 1;
global.idle_drawn = -1;    # cursor state last drawn for the idle line

fun random_glitch_char() {
  index = Math.Int(Math.Random() * global.glitch_count);
  if (index >= global.glitch_count) {
    index = global.glitch_count - 1;
  }
  return global.glitch_chars.CharAt(index);
}

fun draw_line(index, text, r, g, b) {
  global.line_sprites[index].SetImage(Image.Text(text, r, g, b));
  global.line_sprites[index].SetOpacity(global.console_visible);
}

# A finished line settles into the dim log color
fun draw_done_line(index) {
  draw_line(index, global.boot_lines[index], global.dim_r, global.dim_g, global.dim_b);
}

# The line being decoded: revealed text plus a scrambling character
fun draw_typing_line(index, revealed) {
  text = global.boot_lines[index].SubString(0, revealed) + random_glitch_char();
  draw_line(index, text, global.green_r, global.green_g, global.green_b);
}

# A completed line waiting on boot progress keeps a blinking cursor
fun draw_idle_line(index, cursor_on) {
  text = global.boot_lines[index];
  if (cursor_on == 1) {
    text = text + " " + global.cursor_char;
  }
  draw_line(index, text, global.green_r, global.green_g, global.green_b);
}

fun animate_console() {
  global.cursor_tick++;
  if (global.cursor_tick >= global.blink_frames) {
    global.cursor_tick = 0;
    global.cursor_on = 1 - global.cursor_on;
  }

  if (global.type_line < global.line_count && global.type_line < global.lines_allowed) {
    global.type_tick++;
    if (global.type_tick >= global.type_frames) {
      global.type_tick = 0;
      global.type_pos++;

      if (global.type_pos >= global.boot_lines[global.type_line].Length()) {
        # Line complete: the previous line dims, this one becomes the idle line
        if (global.type_line > 0) {
          draw_done_line(global.type_line - 1);
        }
        draw_idle_line(global.type_line, 1);
        global.idle_drawn = 1;
        global.cursor_on = 1;
        global.cursor_tick = 0;
        global.type_line++;
        global.type_pos = 0;
      } else {
        if (global.type_pos == 1 && global.type_line > 0) {
          draw_done_line(global.type_line - 1);
        }
        draw_typing_line(global.type_line, global.type_pos);
      }
    }
  } else if (global.type_line > 0) {
    if (global.idle_drawn != global.cursor_on) {
      draw_idle_line(global.type_line - 1, global.cursor_on);
      global.idle_drawn = global.cursor_on;
    }
  }
}

fun update_console_progress(progress) {
  allowed = Math.Int(progress * global.line_count) + 1;
  if (allowed > global.line_count) {
    allowed = global.line_count;
  }
  if (allowed > global.lines_allowed) {
    global.lines_allowed = allowed;
  }
}

fun show_console() {
  global.console_visible = 1;
  for (i = 0; i < global.type_line; i++) {
    global.line_sprites[i].SetOpacity(1);
  }
}

fun hide_console() {
  global.console_visible = 0;
  for (i = 0; i < global.line_count; i++) {
    global.line_sprites[i].SetOpacity(0);
  }
}

#----------------------------------------- Progress line --------------------------------

global.bar_width = 320;
global.bar_height = 2;
global.bar_blocks = "████████████████████████████████";

track.source = Image.Text(global.bar_blocks, global.muted_r, global.muted_g, global.muted_b);
track.image = track.source.Scale(global.bar_width, global.bar_height);
track.sprite = Sprite(track.image);
track.x = Window.GetWidth() / 2 - global.bar_width / 2;
track.y = logo.bottom + 22;
track.sprite.SetPosition(track.x, track.y, 0);
track.sprite.SetOpacity(1);

progress_bar.source = Image.Text(global.bar_blocks, global.green_r, global.green_g, global.green_b);
progress_bar.full_image = progress_bar.source.Scale(global.bar_width, global.bar_height);
progress_bar.sprite = Sprite();
progress_bar.sprite.SetImage(progress_bar.full_image.Scale(1, global.bar_height));
progress_bar.sprite.SetPosition(track.x, track.y, 1);
progress_bar.sprite.SetOpacity(1);

fun update_progress_bar(progress) {
  # Only update if progress is moving forward
  if (progress > global.max_progress) {
    global.max_progress = progress;

    width = Math.Int(global.bar_width * progress);
    if (width < 1) {
      width = 1;
    }
    if (width > global.bar_width) {
      width = global.bar_width;
    }

    progress_bar.sprite.SetImage(progress_bar.full_image.Scale(width, global.bar_height));
    update_console_progress(progress);
  }
}

fun show_progress() {
  track.sprite.SetOpacity(1);
  progress_bar.sprite.SetOpacity(1);
  show_console();
}

fun hide_progress() {
  track.sprite.SetOpacity(0);
  progress_bar.sprite.SetOpacity(0);
  hide_console();
}

fun refresh_callback() {
  global.animation_frame++;

  # Animate fake progress to limit over time with easing
  if (global.fake_progress_active == 1) {
    elapsed_time = global.animation_frame / 50.0; # Convert frames to seconds (50 FPS)

    time_ratio = elapsed_time / global.fake_progress_duration;
    if (time_ratio > 1.0) {
      time_ratio = 1.0;
    }

    # Ease-out quadratic: 1 - (1 - x)^2
    eased_ratio = 1 - ((1 - time_ratio) * (1 - time_ratio));

    global.fake_progress = eased_ratio * global.fake_progress_limit;
    update_progress_bar(global.fake_progress);
  }

  animate_console();
}

Plymouth.SetRefreshFunction(refresh_callback);

#----------------------------------------- Helper Functions --------------------------------

fun show_password_dialog() {
  lock.sprite.SetOpacity(1);
  entry.sprite.SetOpacity(1);
}

fun hide_password_dialog() {
  lock.sprite.SetOpacity(0);
  entry.sprite.SetOpacity(0);

  for (index = 0; bullet.sprites[index]; index++) {
    bullet.sprites[index].SetOpacity(0);
  }
}

fun start_fake_progress() {
  global.fake_progress_active = 1;

  # Reset fake progress
  global.animation_frame = 0;
  global.max_progress = 0.0;
  global.fake_progress = 0.0;
  global.fake_progress_start_time = 0.0;
}

fun stop_fake_progress() {
  global.fake_progress_active = 0;
}

#----------------------------------------- Dialogue --------------------------------

lock.image = Image("lock.png");
entry.image = Image("entry.png");
bullet.image = Image("bullet.png");

entry.sprite = Sprite(entry.image);
entry.x = Window.GetWidth() / 2 - entry.image.GetWidth() / 2;
entry.y = logo.bottom + 40;
entry.sprite.SetPosition(entry.x, entry.y, 10001);
entry.sprite.SetOpacity(0);

# Scale lock to be slightly shorter than entry field height
# Original lock is 84x96, entry height determines scale
lock_height = entry.image.GetHeight() * 0.8;
lock_scale = lock_height / 96;
lock_width = 84 * lock_scale;

scaled_lock = lock.image.Scale(lock_width, lock_height);
lock.sprite = Sprite(scaled_lock);
lock.x = entry.x - lock_width - 15;
lock.y = entry.y + entry.image.GetHeight() / 2 - lock_height / 2;
lock.sprite.SetPosition(lock.x, lock.y, 10001);
lock.sprite.SetOpacity(0);

# Bullet array
bullet.sprites = [];

fun display_normal_callback() {
  hide_password_dialog();

  mode = Plymouth.GetMode();

  # Bring the readout back after drive decryption during boot and resume
  if ((mode == "boot" || mode == "resume") && global.password_shown == 1) {
    show_progress();
    start_fake_progress();
  }
}

fun display_password_callback(prompt, bullets) {
  global.password_shown = 1;

  # Pause the readout while the password dialog is up
  stop_fake_progress();
  hide_progress();
  show_password_dialog();

  # Clear all bullets first
  for (index = 0; bullet.sprites[index]; index++) {
    bullet.sprites[index].SetOpacity(0);
  }

  # Create and show bullets for current password (max 21)
  max_bullets = 21;
  bullets_to_show = bullets;
  if (bullets_to_show > max_bullets) {
    bullets_to_show = max_bullets;
  }

  for (index = 0; index < bullets_to_show; index++) {
    if (!bullet.sprites[index]) {
      scaled_bullet = bullet.image.Scale(7, 7);
      bullet.sprites[index] = Sprite(scaled_bullet);
      bullet.x = entry.x + 20 + index * (7 + 5);
      bullet.y = entry.y + entry.image.GetHeight() / 2 - 3.5;
      bullet.sprites[index].SetPosition(bullet.x, bullet.y, 10002);
    }

    bullet.sprites[index].SetOpacity(1);
  }
}

Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);

#----------------------------------------- Boot progress --------------------------------

fun progress_callback(duration, progress) {
  # Track when fake progress starts
  # Needed because duration and progress freeze during drive decryption
  if (global.fake_progress_start_time == 0.0) {
    global.fake_progress_start_time = duration;
  }

  global.real_progress = progress;

  # Use real progress once its unfrozen and exceeds fake progress
  if (duration > global.fake_progress_start_time && progress > global.fake_progress) {
    stop_fake_progress();
    update_progress_bar(progress);
  }
}

Plymouth.SetBootProgressFunction(progress_callback);

#----------------------------------------- Message --------------------------------

message_sprite = Sprite();
message_sprite.SetPosition(10, 10, 10000);

fun display_message_callback(text) {
  message = Image.Text(text, global.green_r, global.green_g, global.green_b);
  message_sprite.SetImage(message);
  message_sprite.SetOpacity(1);
}

fun hide_message_callback(text) {
  message_sprite.SetOpacity(0);
}

Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);
