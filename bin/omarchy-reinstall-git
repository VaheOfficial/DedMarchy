#!/bin/bash

# omarchy:summary=Reinstall the DedSec source directory from git

set -e

# Reinstall the Omarchy configuration directory from the git source.

git clone --depth=1 --branch dev "https://github.com/VaheOfficial/DedMarchy.git" ~/.local/share/omarchy-new >/dev/null
mv $OMARCHY_PATH ~/.local/share/omarchy-old
mv ~/.local/share/omarchy-new $OMARCHY_PATH
