#!/bin/bash

# omarchy:summary=Lock the computer and turn off the display
# omarchy:group=system
# omarchy:name=lock
# omarchy:examples=omarchy system lock

# DedSec locks with the Quickshell greeter in lockd mode and falls back to hyprlock.
if command -v quickshell &>/dev/null && [[ -d /opt/dedsec/Greeter ]]; then
  LOCKER=lockd
else
  LOCKER=hyprlock
fi

lock_running() {
  if [[ $LOCKER == "lockd" ]]; then
    pgrep -f "quickshell.*--path /opt/dedsec/Greeter" >/dev/null
  else
    pidof hyprlock >/dev/null
  fi
}

if ! lock_running; then
  (
    if [[ $LOCKER == "lockd" ]]; then
      bash /opt/dedsec/launch-greeter.sh lockd
    else
      hyprlock
    fi
    omarchy-system-wake
  ) &
fi

# Set keyboard layout to default (first layout)
hyprctl switchxkblayout all 0 > /dev/null 2>&1

# Ensure 1password is locked
if pgrep -x "1password" >/dev/null; then
  1password --lock &
fi

# Avoid running screensaver when locked
pkill -f org.omarchy.screensaver

if [[ ${OMARCHY_LOCK_ONLY:-false} != "true" ]]; then
  (
    sleep 3
    lock_running || exit 0
    omarchy-brightness-keyboard off
    omarchy-brightness-display off
  ) &
fi
