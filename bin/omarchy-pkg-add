#!/bin/bash

# omarchy:summary=Install Arch packages if they are missing
# omarchy:args=<packages...>
# omarchy:examples=omarchy pkg add jq ripgrep
# omarchy:requires-sudo=true

if omarchy-pkg-missing "$@"; then
  # DedSec: the install is non-interactive, so resolve the two prompts pacman
  # would otherwise stop on. --overwrite takes files already on disk (custom
  # omarchy-* and BlackArch packages ship overlapping files) and --ask 4 answers
  # yes to "remove conflicting package?", which --noconfirm alone answers no.
  sudo pacman -S --noconfirm --needed --overwrite '*' --ask 4 "$@" || exit 1
fi

for pkg in "$@"; do
  # Secondary check to handle states where pacman doesn't actually register an error
  if ! pacman -Q "$pkg" &>/dev/null; then
    echo -e "\033[31mError: Package '$pkg' did not install\033[0m" >&2
    exit 1
  fi
done

exit 0
